# openwrt-gateway-template settings
# Copy to config.env and adjust for your device before running any script.
# All values below are EXAMPLES.

# ---------------------------------------------------------------- LAN
LAN_IF="lan"
LAN_IP="192.168.10.1/24"
# Bridge member ports of br-lan (DSA port names; check `ls /sys/class/net`)
LAN_PORTS="lan2 lan3 lan4 lan5 lan6 lan7"
# Enable STP on br-lan as a loop safety net (1/0)
LAN_STP="1"
LAN_STP_FORWARD_DELAY="4"

# ---------------------------------------------------------------- WAN
# wan1 = primary uplink, wan2 = backup uplink. Both DHCP clients.
WAN1_IF="wan1"
WAN1_DEV="wan"
WAN2_IF="wan2"
WAN2_DEV="lan1"
WAN1_METRIC="10"
WAN2_METRIC="20"
# Some ISP DHCP servers never ACK requests that carry a DHCP client-id
# (option 61). Set to "none" to omit it, or leave empty for the default.
WAN1_SENDCLIENTID=""
WAN2_SENDCLIENTID=""

# Health-check targets for mwan3 failover
TRACK_IPS="1.1.1.1 9.9.9.9 8.8.8.8"

# ---------------------------------------------------------------- IoT / camera segment
IOT_IF="iot"
IOT_DEV="lan8"                 # dedicated physical port for the IoT access point / devices
IOT_IP="192.168.20.1/24"
IOT_NET="192.168.20.0/24"
# IoT traffic leaves ONLY via this WAN (policy routing); never via the other one.
IOT_EGRESS_IF="$WAN2_IF"
IOT_EGRESS_DEV="$WAN2_DEV"
IOT_BLOCKED_DEV="$WAN1_DEV"
IOT_ROUTE_TABLE="200"

# ---------------------------------------------------------------- AdGuard Home
AGH_WEB_PORT="8080"            # admin UI on the LAN address
# The admin password is asked for at run time (or AGH_PASSWORD env var); never stored here.
AGH_UPSTREAMS="https://dns.quad9.net/dns-query https://cloudflare-dns.com/dns-query"
AGH_BOOTSTRAP="9.9.9.9 1.1.1.1"

# ---------------------------------------------------------------- Security tooling
SNORT_IFACE="$IOT_DEV"         # keep Snort on low-volume segments
SNORT_HOME_NET="192.168.10.0/24 192.168.20.0/24"
CROWDSEC_WAN_DEVS="$WAN1_DEV $WAN2_DEV"

# SQM is prepared on the backup WAN but left disabled (kbit/s, ~85% of measured)
SQM_DEV="$WAN2_DEV"
SQM_DOWN_KBIT="100000"
SQM_UP_KBIT="10000"

# ---------------------------------------------------------------- Optional LuCI extras
# luci-app-snort release (https://github.com/little-schlapps/luci-app-snort/releases)
LUCI_APP_SNORT_URL=""
LUCI_APP_SNORT_SHA256=""
# Argon theme release asset and its SHA-256 (verify against the release page)
ARGON_URL=""
ARGON_SHA256=""
